# SYNCra Digital Agency — environment variable reference.
# Copy to .env.local for local development. Never commit real values.
# Every variable below is a placeholder NAME only — no credentials
# have been inserted, real or fake.

# --- Application -------------------------------------------------
NEXT_PUBLIC_APP_URL=

# --- Database (Prisma / PostgreSQL via Supabase) — Phase 7 --------
# DATABASE_URL: pooled connection (runtime/application, serverless-safe
#   — use Supabase's connection-pooler / PgBouncer URL here).
# DIRECT_URL: direct connection, used only by the Prisma CLI for
#   migrations (Supabase's non-pooled connection string).
DATABASE_URL=
DIRECT_URL=

# --- Auth.js (NextAuth v4, credentials provider) — Phase 7 --------
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# --- Admin bootstrap — Phase 7, OPTIONAL ---------------------------
# Only used by `npm run db:seed`. Both must be set together to create
# or update the single Super Admin account; if either is unset, the
# seed script skips admin bootstrap entirely rather than creating a
# default/fallback account. Never commit real values here.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Object storage (R2/S3) — needed starting Phase 8 --------------
STORAGE_ACCOUNT_ID=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=
STORAGE_PUBLIC_URL=

# --- Resend (transactional email) — Phase 9 -----------------------
# INQUIRY_NOTIFICATION_ADDRESS: where new inquiry notifications are sent.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
INQUIRY_NOTIFICATION_ADDRESS=
